{
  "name": "devpanel",
  "productName": "DevPanel",
  "version": "0.1.0",
  "description": "Desktop dev dashboard with GitHub auto-update and face login",
  "author": "DevCat-HGS",
  "license": "MIT",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.main.json && tsc -p tsconfig.renderer.json && node scripts/copy-static.mjs",
    "build:web": "tsc -p tsconfig.renderer.json && node scripts/copy-static.mjs",
    "serve:web": "npm run build:web && npx --yes serve dist/renderer",
    "start": "node scripts/start.mjs",
    "dist": "npm run build && electron-builder --win --publish never",
    "release": "npm run build && electron-builder --win --publish always",
    "test": "npm run build && npm --prefix installer run build && node --test tests/unit.test.mjs tests/i18n.test.mjs",
    "test:e2e": "npm run build && node tests/e2e.mjs",
    "test:installer": "npm --prefix installer run build && node tests/installer.e2e.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "playwright-core": "^1.63.0",
    "typescript": "^5.7.2"
  },
  "build": {
    "appId": "com.devcat.devpanel",
    "productName": "DevPanel",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "python",
        "to": "python",
        "filter": [
          "*.py",
          "requirements.txt",
          "face_auth.exe",
          "!test_*.py"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DevPanel",
      "artifactName": "DevPanel-Setup-${version}.${ext}",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "language": "3082",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "DevCat-HGS",
        "repo": "DevPanel",
        "releaseType": "release"
      }
    ]
  }
}
